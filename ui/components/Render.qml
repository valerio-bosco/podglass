// Case render of the card. Phases: `case-open.webp` once when the card appears, then a loop -
// `spin.webp` (one slow turn) while waiting to connect, `idle.webp` (small sway) once connected -
// and `case-close.webp` once when the lid closes (the last frame is held while the card exits).
// Placeholder SVG until the renders exist (assets/renders is generated by tools/render, phase 3).
import QtQuick
import ".."

Item {
    id: r
    property bool lidOpen: true
    property bool waiting: false  // not connected yet: the case turns slowly
    property bool playing: false  // set true when the card appears

    readonly property string renders: Paths.assets + "renders/"
    readonly property int closeMs: Paths.hasRenders && !Theme.reduceMotion ? 48 * 33 + 60 : 0
    property string phase: "intro"  // intro | loop | close
    onPlayingChanged: if (playing) phase = "intro"

    function close(): void {
        if (Paths.hasRenders)
            phase = "close";
    }

    AnimatedImage {
        id: anim
        anchors.fill: parent
        fillMode: Image.PreserveAspectFit
        source: !Paths.hasRenders ? ""
            : r.phase === "intro" ? r.renders + "case-open.webp"
            : r.phase === "close" ? r.renders + "case-close.webp"
            : r.renders + (r.waiting ? "spin.webp" : "idle.webp")
        playing: r.playing
        visible: status === AnimatedImage.Ready
        onCurrentFrameChanged: {
            if (frameCount <= 0 || currentFrame !== frameCount - 1)
                return;
            if (r.phase === "intro")
                r.phase = "loop";
            else if (r.phase === "close")
                paused = true;  // hold the closed case until the card is gone
        }
        onSourceChanged: paused = false
    }
    Image {
        anchors.fill: parent
        fillMode: Image.PreserveAspectFit
        smooth: true
        sourceSize: Qt.size(width * 2, height * 2)
        source: Paths.assets + "placeholder/" + (r.lidOpen ? "case-open" : "case-closed") + ".svg"
        visible: anim.status !== AnimatedImage.Ready
    }
}
