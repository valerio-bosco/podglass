// Case render of the card: `case-open.webp` once, then `idle.webp` in a loop. Placeholder SVG
// until the renders exist (assets/renders is generated by tools/render, phase 3).
import QtQuick
import ".."

Item {
    id: r
    property bool lidOpen: true
    property bool playing: false  // set true when the card appears

    readonly property string renders: Paths.assets + "renders/"
    property bool introDone: false
    onPlayingChanged: if (playing) introDone = false

    AnimatedImage {
        id: anim
        anchors.fill: parent
        fillMode: Image.PreserveAspectFit
        source: Paths.hasRenders ? r.renders + (r.introDone ? "idle.webp" : "case-open.webp") : ""
        playing: r.playing
        visible: status === AnimatedImage.Ready
        onCurrentFrameChanged: if (!r.introDone && frameCount > 0 && currentFrame === frameCount - 1) r.introDone = true
    }
    Image {
        anchors.fill: parent
        fillMode: Image.PreserveAspectFit
        smooth: true
        sourceSize: Qt.size(width * 2, height * 2)
        source: Paths.assets + "placeholder/" + (r.lidOpen ? "case-open" : "case-closed") + ".svg"
        visible: anim.status !== AnimatedImage.Ready
    }
}
